# URL publique du site (utilisée pour le SEO, les canoniques et le sitemap)
NEXT_PUBLIC_SITE_URL="https://idjocv.ci"

# Coordonnées publiées sur le site. Laisser vide masque le bloc concerné :
# aucune coordonnée fictive ne doit apparaître en production.
NEXT_PUBLIC_CONTACT_EMAIL="idjocommunication@gmail.com"
NEXT_PUBLIC_CONTACT_PHONE=""
NEXT_PUBLIC_WHATSAPP=""            # chiffres uniquement, ex. 2250707123456
NEXT_PUBLIC_LEGAL_NAME="IDJÔ Communication"
NEXT_PUBLIC_HOST_NAME=""           # hébergeur déclaré dans les mentions légales

# Réception des messages du formulaire de contact. Sans aucun de ces canaux,
# le formulaire bascule honnêtement sur l'e-mail et WhatsApp du visiteur.
RESEND_API_KEY=""
CONTACT_FROM_EMAIL=""              # expéditeur vérifié chez Resend
CONTACT_TO_EMAIL=""                # boîte qui reçoit les messages
CONTACT_WEBHOOK_URL=""             # ou un webhook (Zapier, Make, Apps Script)

# PostgreSQL — optionnel : la plateforme fonctionne sans base (sauvegarde locale)
DATABASE_URL="postgresql://user:password@localhost:5432/idjocv?schema=public"

# Assistant de rédaction — optionnel : sans clé, le générateur local prend le
# relais et l'éditeur fonctionne à l'identique (aucune donnée ne sort alors du
# navigateur).
ANTHROPIC_API_KEY=""

# ---------------------------------------------------------------------------
# Paiement du téléchargement (Wave, Orange Money, MTN, Moov, carte)
# ---------------------------------------------------------------------------
# Tant que NEXT_PUBLIC_PAIEMENT_ACTIF ne vaut pas 1, le téléchargement reste
# libre : le site fonctionne de bout en bout sans compte marchand.
NEXT_PUBLIC_PAIEMENT_ACTIF="0"
NEXT_PUBLIC_PAIEMENT_MODE="bloquant"   # bloquant | libre
NEXT_PUBLIC_PAIEMENT_PRIX="4900"       # en F CFA, multiple de 5
NEXT_PUBLIC_PAIEMENT_DUREE_JOURS="30"

# Compte marchand CinetPay (couvre Wave, Orange Money, MTN, Moov et les cartes)
CINETPAY_API_KEY=""
CINETPAY_SITE_ID=""
# Laisser vide en production ; sert à viser un bac à sable ou un simulateur.
CINETPAY_BASE_URL=""

# Clé de signature des accès accordés — une longue chaîne aléatoire, gardée
# secrète. La changer invalide tous les accès en cours.
PAIEMENT_SECRET=""

# ---------------------------------------------------------------------------
# Envoi du CV en PDF par e-mail (facultatif)
# ---------------------------------------------------------------------------
# Sans ces variables, l'interface annonce que l'envoi n'est pas actif et le
# client télécharge son PDF directement. Voir docs/paiement-mobile-money.md.

# Expéditeur : adresse vérifiée (SPF/DKIM) chez le fournisseur d'e-mail.
EMAIL_EXPEDITEUR=""
EMAIL_EXPEDITEUR_NOM="IDJÔ CV"
# Un fournisseur suffit : Resend (RESEND_API_KEY, déjà utilisé par le contact)
# ou Brevo.
BREVO_API_KEY=""
# Laisser vides en production ; servent à viser un relais interne ou un
# simulateur pendant les tests.
RESEND_BASE_URL=""
BREVO_BASE_URL=""

# Moteur qui fabrique le PDF. Sur un serveur ou un conteneur, installer
# Chromium suffit : il est détecté automatiquement.
CHROMIUM_PATH=""
# En hébergement sans serveur, passer par un service de conversion HTTP.
PDF_API_URL=""
PDF_API_KEY=""
PDF_API_FORMAT="browserless"   # browserless | pdfshift

# ---------------------------------------------------------------------------
# Cible de déploiement
# ---------------------------------------------------------------------------
# Renseigné automatiquement par `npm run build:statique` : n'y touchez pas ici.
# À 1, le site sait qu'aucune route serveur n'existe (hébergement mutualisé) et
# bascule sur ses replis navigateur — générateur local de l'assistant, analyse
# du CV importé dans la page, contact par e-mail ou WhatsApp, téléchargement
# libre. Voir deploiement/README.md.
NEXT_PUBLIC_SANS_SERVEUR="0"
